# RealDiag Test Environment Configuration
# =========================================
# This file configures the test environment for real-world testing
# Users in this environment have free access to all features

# Environment
ENVIRONMENT=test
NODE_ENV=test

# Test Environment Flag
TESTING_MODE=true
FREE_ACCESS_TESTING=true

# Database (use separate test database)
DATABASE_URL=postgresql://user:password@localhost:5432/realdiag_test
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/realdiag_test

# API Configuration
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Authentication (use test secrets)
JWT_SECRET_KEY=test_only_secret_key_do_not_use_in_production_32chars
JWT_SECRET=test_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_DAYS=7

# Disable rate limiting for testing
RATE_LIMIT_ENABLED=false
FREE_SEARCH_LIMIT=999999

# Subscription - All features unlocked for testing
SUBSCRIPTION_CHECK_ENABLED=false
TEST_MODE_UNLIMITED_ACCESS=true

# Security - Relaxed for testing
SECURITY_ENABLED=false
MFA_REQUIRED=false
ENCRYPTION_ENABLED=false

# Email (use test email service or disable)
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@realdiag.com
SMTP_PASSWORD=testpassword
SMTP_FROM=noreply@test.realdiag.com

# Sentry (disabled for test environment)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Logging
LOG_LEVEL=INFO
DEBUG=true

# CORS - Allow test origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Feature Flags for Testing
ENABLE_ALL_FEATURES=true
ENABLE_EXPERIMENTAL_FEATURES=true
BYPASS_SUBSCRIPTION_CHECKS=true

# Payment Integration (disabled for testing)
STRIPE_ENABLED=false
STRIPE_TEST_MODE=true
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# External Services (use test endpoints or mock)
EXTERNAL_API_ENABLED=false
MOCK_EXTERNAL_SERVICES=true

# Test User Credentials (for automated testing)
TEST_USER_EMAIL=testuser@realdiag.com
TEST_USER_PASSWORD=TestPassword123!
TEST_ADMIN_EMAIL=admin@realdiag.com
TEST_ADMIN_PASSWORD=AdminPassword123!

# Session Configuration
SESSION_SECRET=test_session_secret
SESSION_LIFETIME=86400

# Redis (optional for test caching)
REDIS_URL=redis://localhost:6379/1
REDIS_ENABLED=false

# Analytics (disabled for testing)
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=

# File Upload Limits (relaxed for testing)
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=50

# Test Data
SEED_TEST_DATA=true
AUTO_RESET_DB=false
