# RealDiag-Software Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==========================================
# Application Settings
# ==========================================
APP_NAME=RealDiag
APP_VERSION=1.4.0
ENVIRONMENT=production  # development, staging, production
DEBUG=false

# ==========================================
# Security & Authentication
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_32_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Session settings
SESSION_TIMEOUT_MINUTES=15
MAX_SESSION_DURATION_HOURS=8

# Password requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ==========================================
# API Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.realdiag.com
FRONTEND_URL=https://realdiag.com

# CORS origins (comma-separated)
CORS_ORIGINS=https://realdiag.com,https://www.realdiag.com

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL (recommended for production)
DATABASE_TYPE=postgresql  # postgresql, mongodb, or sqlite (dev only)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=realdiag_prod
DATABASE_USER=realdiag_user
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DATABASE_SSL_MODE=require

# Connection pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# MongoDB (alternative)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/realdiag?retryWrites=true&w=majority
# MONGODB_DATABASE=realdiag_prod

# Database encryption
DATABASE_ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_HEX_KEY

# ==========================================
# Redis Configuration (Caching & Sessions)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_REDIS_PASSWORD
REDIS_DB=0
REDIS_SSL=true

# Cache TTL (seconds)
CACHE_TTL_SHORT=300      # 5 minutes
CACHE_TTL_MEDIUM=3600    # 1 hour
CACHE_TTL_LONG=86400     # 24 hours

# ==========================================
# Error Tracking & Monitoring
# ==========================================
# Sentry (https://sentry.io)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=/var/log/realdiag/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PHI_ACCESS=true
AUDIT_LOG_FILE=/var/log/realdiag/audit.log

# ==========================================
# Email Configuration (for notifications)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@realdiag.com
SMTP_PASSWORD=CHANGE_ME_TO_EMAIL_PASSWORD
SMTP_FROM_EMAIL=noreply@realdiag.com
SMTP_FROM_NAME=RealDiag
SMTP_USE_TLS=true

# ==========================================
# AWS Configuration (if using AWS services)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_TO_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_TO_AWS_SECRET

# S3 for file storage
AWS_S3_BUCKET=realdiag-prod-files
AWS_S3_BACKUP_BUCKET=realdiag-prod-backups

# Secrets Manager
AWS_SECRETS_MANAGER_ENABLED=false
AWS_SECRET_NAME=realdiag/prod/credentials

# ==========================================
# External Integrations
# ==========================================

# ==========================================
# Epic/EHR FHIR Integration (SMART on FHIR)
# ==========================================
# Epic FHIR Base URL
# Production: https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# Sandbox: https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# SMART on FHIR OAuth Credentials (from Epic App Oriel)
# Get credentials at: https://apporchard.epic.com/
SMART_CLIENT_ID=CHANGE_ME_TO_EPIC_CLIENT_ID
SMART_CLIENT_SECRET=CHANGE_ME_TO_EPIC_CLIENT_SECRET

# OAuth Redirect URI (must match Epic App Oriel configuration)
# Development: http://localhost:8000/smart/callback
# Production: https://realdiag-software.onrender.com/smart/callback
SMART_REDIRECT_URI=https://realdiag-software.onrender.com/smart/callback

# SMART Launch URL (configured in Epic App Oriel)
SMART_LAUNCH_URL=https://realdiag-software.onrender.com/smart/launch

# Epic OAuth Endpoints
SMART_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
SMART_AUTH_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize

# FHIR Query Settings
FHIR_LAB_DAYS_BACK=30  # How far back to fetch lab results
FHIR_VITAL_DAYS_BACK=7  # How far back to fetch vital signs
FHIR_CONDITION_DAYS_BACK=180  # Active conditions in last 6 months

# Alternative EHR Systems (for future multi-EHR support)
# Cerner/Oracle Health
# CERNER_FHIR_BASE_URL=https://fhir-myrecord.cerner.com/r4/{tenant_id}
# CERNER_CLIENT_ID=CHANGE_ME
# CERNER_CLIENT_SECRET=CHANGE_ME

# Allscripts
# ALLSCRIPTS_FHIR_BASE_URL=CHANGE_ME
# ALLSCRIPTS_CLIENT_ID=CHANGE_ME
# ALLSCRIPTS_CLIENT_SECRET=CHANGE_ME

# HL7 Integration (for legacy systems)
HL7_ENABLED=false
HL7_HOST=localhost
HL7_PORT=2575

# API Keys for third-party services
OPENAI_API_KEY=CHANGE_ME_IF_USING_AI_FEATURES
TWILIO_ACCOUNT_SID=CHANGE_ME_IF_USING_SMS
TWILIO_AUTH_TOKEN=CHANGE_ME_IF_USING_SMS

# ==========================================
# Security Headers & HTTPS
# ==========================================
HTTPS_ONLY=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000  # 1 year
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict  # strict, lax, or none

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_URI=https://realdiag.com/csp-report

# ==========================================
# Feature Flags
# ==========================================
FEATURE_MFA_ENABLED=true
FEATURE_RBAC_ENABLED=true
FEATURE_OFFLINE_MODE=true
FEATURE_PDF_EXPORT=true
FEATURE_EHR_INTEGRATION=true
FEATURE_EDUCATION_MODE=true

# ==========================================
# Backup Configuration
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_BACKUP_ENCRYPTION_KEY

# ==========================================
# Performance & Scalability
# ==========================================
WORKER_PROCESSES=4
WORKER_THREADS=2
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=30
KEEPALIVE_TIMEOUT=5

# CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.realdiag.com

# ==========================================
# Compliance & Privacy
# ==========================================
HIPAA_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=true
DATA_RETENTION_DAYS=2555  # 7 years for medical records
PHI_ENCRYPTION_ENABLED=true

# Analytics (privacy-compliant only)
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=plausible  # plausible, matomo (no Google Analytics for PHI)

# ==========================================
# Development/Testing (disable in production!)
# ==========================================
# TESTING=false
# MOCK_EXTERNAL_APIS=false
# SEED_DATABASE=false
# ALLOW_INSECURE_CONNECTIONS=false
