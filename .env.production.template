# RealDiag Production Environment Variables
# ==========================================
# Copy this file to .env for production deployment
# NEVER commit .env to version control!

# ==========================================
# CRITICAL SECURITY SETTINGS
# ==========================================

# JWT Secret Key - MUST BE CHANGED IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_32_CHARS_MIN

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60  # Access token: 1 hour
REFRESH_TOKEN_EXPIRATION_DAYS=7  # Refresh token: 7 days

# Cookie Security (MUST be true in production with HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=strict  # strict, lax, or none
COOKIE_DOMAIN=  # Leave empty for same domain, or set to .yourdomain.com

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=production
DEBUG=false
APP_NAME=RealDiag
APP_VERSION=1.4.0

# ==========================================
# API Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.realdiag.com
FRONTEND_URL=https://realdiag.com

# CORS Origins (comma-separated)
CORS_ORIGINS=https://realdiag.com,https://www.realdiag.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL (recommended for production)
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=realdiag_prod
DATABASE_USER=realdiag_user
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DATABASE_SSL_MODE=require

# Connection Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Sentry Error Tracking
# Get your DSN from: https://sentry.io → Settings → Projects → Client Keys (DSN)
# Format: https://abc123@o123456.ingest.sentry.io/789012
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # Sample 10% of transactions for performance monitoring
SENTRY_PROFILES_SAMPLE_RATE=0.1  # Sample 10% of profiles

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# SECURITY HEADERS
# ==========================================
HTTPS_ONLY=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
SECURE_COOKIES=true

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
