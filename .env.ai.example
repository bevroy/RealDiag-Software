# AI Tree Generation Configuration
# ================================
# Settings for automatic decision tree generation

# Enable AI tree generation (set to "true" to enable)
ENABLE_AI_GENERATION=false

# AI Provider: "openai" or "claude"
AI_PROVIDER=claude

# API Keys (required if AI generation is enabled)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Admin authentication token for tree review
# Generate a secure random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=your_secure_admin_token_here

# AI Generation Settings
AI_TEMPERATURE=0.3  # Lower = more conservative (0.0-1.0)
AI_MAX_TOKENS=4000  # Maximum tokens for generated tree

# Minimum requirements to trigger AI generation
MIN_SYMPTOMS_FOR_AI=2  # Minimum number of symptoms required
MIN_CONFIDENCE_THRESHOLD=2.0  # If best result score < this, trigger AI

# Notes:
# - Claude (Anthropic) is recommended for medical content
# - OpenAI GPT-4 Turbo is also supported
# - Keep temperature low (0.2-0.4) for clinical accuracy
# - Admin token must be kept secure and rotated regularly
# - AI generation can be expensive - monitor API usage
